{
  "name": "noodara",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "dev": "turbo run dev dev:worker",
    "build": "turbo run build",
    "start": "pnpm --filter @noodara/control-plane start",
    "start:worker": "pnpm --filter @noodara/control-plane start:worker",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck && tsc -p tests/integration/ssh/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:boot": "vitest run --config vitest.integration.config.ts tests/integration/boot/boot-command.test.ts",
    "test:e2e": "echo 'test:e2e: Playwright E2E suite lands in phase 5' && exit 0",
    "db:migrate": "pnpm --filter @noodara/control-plane db:migrate",
    "boundaries": "turbo boundaries",
    "security:scan-leaks": "vitest run --config vitest.integration.config.ts tests/integration/activity/canary.test.ts tests/integration/activity/canary-full-flow.test.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@noodara/domain": "workspace:*",
    "@noodara/ssh": "workspace:*",
    "@testcontainers/postgresql": "12.1.0",
    "@testcontainers/redis": "12.1.0",
    "@types/node": "^22.12.0",
    "@vitest/coverage-v8": "5.0.0",
    "bullmq": "6.3.6",
    "drizzle-orm": "0.45.2",
    "eslint": "^9.39.5",
    "globals": "^17.12.0",
    "ioredis": "5.11.1",
    "prettier": "^3.9.6",
    "set-cookie-parser": "3.1.2",
    "testcontainers": "12.1.0",
    "turbo": "^2.10.12",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.70.0",
    "uuidv7": "1.2.1",
    "vitest": "5.0.0",
    "zod": "4.6.1"
  }
}
