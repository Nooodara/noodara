{
  "name": "noodara",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "dev": "turbo run dev dev:worker",
    "build": "turbo run build",
    "start": "pnpm --filter @noodara/control-plane start",
    "start:worker": "pnpm --filter @noodara/control-plane start:worker",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck && tsc -p tests/integration/ssh/tsconfig.json --noEmit && tsc -p tests/e2e/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:boot": "vitest run --config vitest.integration.config.ts tests/integration/boot/boot-command.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:repeat": "node scripts/e2e-repeat.mjs",
    "test:e2e:report": "playwright show-report",
    "e2e:install": "playwright install chromium",
    "db:migrate": "pnpm --filter @noodara/control-plane db:migrate",
    "boundaries": "turbo boundaries",
    "check:ui-safety": "node scripts/check-ui-safety.mjs",
    "check:posix-sh": "node scripts/check-posix-sh.mjs install.sh",
    "security:scan-leaks": "vitest run --config vitest.integration.config.ts tests/integration/activity/canary.test.ts tests/integration/activity/canary-full-flow.test.ts tests/integration/activity/canary-http.test.ts && playwright test --grep @canary"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@noodara/config": "workspace:*",
    "@noodara/domain": "workspace:*",
    "@playwright/test": "1.63.0",
    "@noodara/ssh": "workspace:*",
    "@testcontainers/postgresql": "12.1.0",
    "@testcontainers/redis": "12.1.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "^22.12.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.0",
    "bullmq": "6.3.6",
    "drizzle-orm": "0.45.2",
    "eslint": "^9.39.5",
    "globals": "^17.12.0",
    "ioredis": "5.11.1",
    "jsdom": "30.1.0",
    "prettier": "^3.9.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "set-cookie-parser": "3.1.2",
    "testcontainers": "12.1.0",
    "turbo": "^2.10.12",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.70.0",
    "uuidv7": "1.2.1",
    "vitest": "5.0.0",
    "zod": "4.6.1"
  }
}
