# AI assistant config (not versioned)
.claude/
CLAUDE.md

# Node
node_modules/
dist/
.turbo/
coverage/

# Next.js (apps/web)
.next/
next-env.d.ts
*.tsbuildinfo

# Playwright (tests/e2e)
playwright-report/
test-results/
blob-report/

# Env
.env
.env.*
!.env.example

# Brand review captures (07-04)
# Regenerated on demand by `pnpm brand:boards` / `pnpm brand:review`; only the approved concept's
# files are ever committed, and the approval plan copies those into docs/brand/approved/.
docs/brand/review/*
!docs/brand/review/README.md

# UI review captures (08-01)
# Regenerated on demand by `pnpm ui:review`; only the 1280px set approved at each gate (G1/G2/G3)
# is ever committed, into docs/ui/approved/ (D-15).
docs/ui/review/*
!docs/ui/review/README.md

# Public site build output (10-01)
# Regenerated on demand by `pnpm site:build`/`pnpm --filter @noodara/site build`; never committed.
apps/site/out/
apps/site/.source/

# Public site synced assets (10-02, T-10-13)
# Regenerated on every dev/build run by apps/site/scripts/sync-site-assets.mjs from
# packages/ui/brand/* and docs/ui/approved/*; never hand-edited or committed as a site file.
apps/site/public/screenshots/
apps/site/src/app/favicon.ico
apps/site/src/app/icon.svg
apps/site/src/app/apple-icon.png
apps/site/src/app/opengraph-image.png

# OS
.DS_Store
