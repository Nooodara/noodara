{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {},
    "test:integration": {}
  },
  "boundaries": {
    "tags": {
      "pure-domain": {
        "dependencies": {
          "allow": ["pure-domain", "@noodara/config"]
        }
      }
    }
  }
}
