{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "out/**"],
      "env": ["NOODARA_API_ORIGIN"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "NOODARA_MASTER_KEY",
        "NOODARA_MASTER_KEY_PREVIOUS",
        "BETTER_AUTH_SECRET",
        "DATABASE_URL",
        "REDIS_URL",
        "NOODARA_PUBLIC_URL",
        "NOODARA_API_ORIGIN",
        "NOODARA_ADMIN_EMAIL",
        "NOODARA_ADMIN_PASSWORD",
        "NOODARA_SESSION_SLIDING_SECONDS",
        "NOODARA_SESSION_UPDATE_AGE_SECONDS",
        "NOODARA_SESSION_ABSOLUTE_SECONDS",
        "NOODARA_LOGIN_MAX_ATTEMPTS",
        "NOODARA_LOGIN_WINDOW_SECONDS",
        "NOODARA_LOGIN_BACKOFF_MAX_SECONDS",
        "NOODARA_COOKIE_INSECURE",
        "NOODARA_TRUST_PROXY",
        "PORT",
        "LOG_LEVEL",
        "NOODARA_SSH_CONNECT_TIMEOUT_MS",
        "NOODARA_SSH_COMMAND_TIMEOUT_MS",
        "NOODARA_SSH_DISCOVERY_TIMEOUT_MS",
        "NOODARA_WORKER_CONCURRENCY",
        "NOODARA_SSE_MAX_CONNECTIONS",
        "NOODARA_DEPLOY_MAX_MS",
        "NOODARA_DEPLOY_IDLE_MS",
        "NOODARA_DEPLOY_CONCURRENCY",
        "NOODARA_DEPLOY_LOG_MAX_BYTES",
        "NOODARA_DEPLOY_LOG_FLUSH_MS",
        "NOODARA_DEPLOY_LOG_FLUSH_BYTES",
        "NOODARA_DEPLOY_LOG_RETENTION_DAYS",
        "NOODARA_RECONCILE_INTERVAL_MS",
        "NOODARA_RUNTIME_LOG_TAIL",
        "NOODARA_RUNTIME_LOG_FOLLOW_MAX_MS",
        "NOODARA_DEPLOY_QUEUED_STALE_MS"
      ]
    },
    "dev:worker": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "NOODARA_MASTER_KEY",
        "NOODARA_MASTER_KEY_PREVIOUS",
        "BETTER_AUTH_SECRET",
        "DATABASE_URL",
        "REDIS_URL",
        "NOODARA_PUBLIC_URL",
        "NOODARA_ADMIN_EMAIL",
        "NOODARA_ADMIN_PASSWORD",
        "NOODARA_SESSION_SLIDING_SECONDS",
        "NOODARA_SESSION_UPDATE_AGE_SECONDS",
        "NOODARA_SESSION_ABSOLUTE_SECONDS",
        "NOODARA_LOGIN_MAX_ATTEMPTS",
        "NOODARA_LOGIN_WINDOW_SECONDS",
        "NOODARA_LOGIN_BACKOFF_MAX_SECONDS",
        "NOODARA_COOKIE_INSECURE",
        "NOODARA_TRUST_PROXY",
        "PORT",
        "LOG_LEVEL",
        "NOODARA_SSH_CONNECT_TIMEOUT_MS",
        "NOODARA_SSH_COMMAND_TIMEOUT_MS",
        "NOODARA_SSH_DISCOVERY_TIMEOUT_MS",
        "NOODARA_WORKER_CONCURRENCY",
        "NOODARA_SSE_MAX_CONNECTIONS",
        "NOODARA_DEPLOY_MAX_MS",
        "NOODARA_DEPLOY_IDLE_MS",
        "NOODARA_DEPLOY_CONCURRENCY",
        "NOODARA_DEPLOY_LOG_MAX_BYTES",
        "NOODARA_DEPLOY_LOG_FLUSH_MS",
        "NOODARA_DEPLOY_LOG_FLUSH_BYTES",
        "NOODARA_DEPLOY_LOG_RETENTION_DAYS",
        "NOODARA_RECONCILE_INTERVAL_MS",
        "NOODARA_RUNTIME_LOG_TAIL",
        "NOODARA_RUNTIME_LOG_FOLLOW_MAX_MS",
        "NOODARA_DEPLOY_QUEUED_STALE_MS"
      ]
    },
    "test": {},
    "test:integration": {}
  },
  "boundaries": {
    "tags": {
      "pure-domain": {
        "dependencies": {
          "allow": ["pure-domain", "@noodara/config", "ssh-adapter", "ui-components"]
        }
      },
      "ssh-adapter": {
        "dependencies": {
          "allow": ["pure-domain", "@noodara/config", "ssh-adapter"]
        }
      },
      "ui-components": {
        "dependencies": {
          "allow": ["ui-components", "@noodara/config", "pure-domain", "ssh-adapter"]
        }
      },
      "public-site": {
        "dependencies": {
          "deny": ["@noodara/control-plane", "@noodara/web"]
        }
      }
    }
  }
}
