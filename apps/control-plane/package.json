{
  "name": "@noodara/control-plane",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --experimental-strip-types src/server.ts",
    "build": "tsc -p tsconfig.json",
    "lint": "eslint --config ../../packages/config/eslint.config.js .",
    "typecheck": "tsc --noEmit",
