    "@noodara/domain": "workspace:*",
    "fastify": "5.12.3",
    "pino": "10.3.1",
    "zod": "4.6.1"
  },
  "devDependencies": {
    "@noodara/config": "workspace:*",
    "@types/node": "^22.12.0",
    "vitest": "5.0.0"
  }
}
