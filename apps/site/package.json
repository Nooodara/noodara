{
  "name": "@noodara/site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "turbo": {
    "tags": ["public-site"]
  },
  "scripts": {
    "dev": "node scripts/sync-site-assets.mjs && next dev --port 3200",
    "build": "node scripts/sync-site-assets.mjs && next build && node scripts/check-export.mjs",
    "lint": "eslint --config ../../packages/config/eslint.config.js --ignore-pattern out --ignore-pattern .source .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --root ../.. --project apps --project dom"
  },
  "dependencies": {
    "@noodara/ui": "workspace:*",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "fumadocs-core": "16.15.15",
    "fumadocs-ui": "16.15.15",
    "flexsearch": "0.8.212"
  },
  "devDependencies": {
    "fumadocs-mdx": "15.4.5",
    "@types/mdx": "2.0.14",
    "@noodara/config": "workspace:*",
    "@tailwindcss/postcss": "4.3.3",
    "tailwindcss": "4.3.3",
    "@types/node": "^22.12.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "vitest": "5.0.0"
  }
}
