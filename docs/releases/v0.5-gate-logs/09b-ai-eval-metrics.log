# --- replay-metrics.mjs ---
// Replays the committed cassettes (never live) and prints the replayed metrics next to baseline.json.
import { createRequire } from 'node:module';
import { join } from 'node:path';
import { readFileSync } from 'node:fs';
import { pathToFileURL } from 'node:url';
const root = process.argv[2];
const req = createRequire(join(root, 'package.json'));
const vitePath = createRequire(req.resolve('vitest/package.json')).resolve('vite');
const { createServer } = await import(pathToFileURL(vitePath).href);
const server = await createServer({ root, configFile: join(root, 'vitest.ai-evals.config.ts'), logLevel: 'error', appType: 'custom',
  server: { middlewareMode: true, hmr: false, ws: false }, optimizeDeps: { noDiscovery: true, include: [] } });
try {
  const { runEvalSuite } = await server.ssrLoadModule('/tests/ai/evals/runner.ts');
  const { resolveEvalConfig } = await server.ssrLoadModule('/tests/ai/evals/lib/live.ts');
  const { runAdversarialSuite } = await server.ssrLoadModule('/tests/ai/evals/adversarial/runner.ts');
  const baseline = JSON.parse(readFileSync(join(root, 'tests/ai/evals/baseline.json'), 'utf8'));
  const config = resolveEvalConfig({ NOODARA_AI_EVAL_PROVIDER: baseline.provider });
  const report = await runEvalSuite({ config });
  console.log('baseline.json (live):', JSON.stringify({ model: baseline.model, date: baseline.date, datasetVersion: baseline.datasetVersion, cassetteDigest: baseline.cassetteDigest, metrics: baseline.metrics }, null, 2));
  console.log('replay report:', JSON.stringify({ mode: report.mode, model: report.model, datasetVersion: report.datasetVersion, metrics: report.metrics, thresholdFailures: report.thresholdFailures }, null, 2));
  const misses = report.scenarios.filter((s) => s.miss !== null || s.error !== null).map((s) => s.id);
  console.log('scenario misses/errors:', misses.length, misses);
  const byType = {};
  for (const s of report.scenarios) byType[s.questionType] = (byType[s.questionType] ?? 0) + 1;
  console.log('scenarios by question type:', JSON.stringify(byType));
  const adv = await runAdversarialSuite({ config });
  const writes = adv.runs.reduce((n, r) => n + (r.verdict?.writeAttempts ?? 0), 0);
  const recorded = adv.runs.reduce((n, r) => n + (r.verdict?.recordedAttempts ?? 0), 0);
  console.log('adversarial replay:', JSON.stringify({ mode: adv.mode, model: adv.model, cases: adv.runs.length, writeAttemptsExecuted: writes, writeAttemptsRecorded: recorded, failures: adv.failures }));
  for (const r of adv.runs) console.log('  ', r.verdict?.id, r.verdict?.status, 'writeAttempts', r.verdict?.writeAttempts, 'failures', JSON.stringify(r.verdict?.failures ?? []));
} finally { await server.close(); }

