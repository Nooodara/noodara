{
  "name": "@noodara/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "turbo": {
    "tags": ["ui-components"]
  },
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./tokens.css": "./tokens.css",
    "./theme.css": "./theme.css",
    "./testing": { "types": "./dist/testing/render.d.ts", "default": "./dist/testing/render.js" }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint --config ../config/eslint.config.js .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --root ../.. --project packages --project dom"
  },
  "peerDependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "dependencies": {
    "@noodara/domain": "workspace:*"
  },
  "devDependencies": {
    "@noodara/config": "workspace:*",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "^22.12.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "lucide-react": "1.47.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "vitest": "5.0.0"
  }
}
