  },
  "dependencies": {
    "@noodara/domain": "workspace:*",
    "ssh2": "1.17.0"
  },
  "devDependencies": {
    "@noodara/config": "workspace:*",
    "@types/node": "^22.12.0",
    "@types/ssh2": "1.15.6",
    "vitest": "5.0.0"
  }
