{
  "name": "@noodara/domain",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "turbo": {
    "tags": ["pure-domain"]
  },
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./server": { "types": "./dist/server/index.d.ts", "default": "./dist/server/index.js" },
    "./security": { "types": "./dist/security/index.d.ts", "default": "./dist/security/index.js" },
    "./validators": { "types": "./dist/validators/index.d.ts", "default": "./dist/validators/index.js" },
    "./activity": { "types": "./dist/activity/index.d.ts", "default": "./dist/activity/index.js" },
    "./discovery": { "types": "./dist/discovery/index.d.ts", "default": "./dist/discovery/index.js" }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint --config ../config/eslint.config.js .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --root ../.. --project packages"
  },
  "dependencies": {
    "zod": "4.6.1"
  },
  "devDependencies": {
    "@noodara/config": "workspace:*",
    "@types/node": "^22.12.0",
    "vitest": "5.0.0"
  }
}
