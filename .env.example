# Copy to .env and fill in every value before running `docker compose -f docker-compose.dev.yml
# up` or `pnpm db:migrate`. No variable here has a default anywhere in the codebase (INST-06) —
# the process refuses to start without a real value.

# 32 raw bytes, base64-encoded. Generate with: openssl rand -base64 32
# Back this value up. Credentials encrypted with it are unrecoverable without it (D-09, D-12).
NOODARA_MASTER_KEY=

# At least 32 characters, not a known placeholder. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# postgresql://<user>:<password>@<host>:<port>/<database> — password must not be a placeholder.
DATABASE_URL=

REDIS_URL=

# Public origin the control plane is served from, e.g. https://noodara.example.com
NOODARA_PUBLIC_URL=

# The origin apps/web's next.config.ts proxies /api/* to (docs/adr/0006), e.g. http://localhost:3100
# in dev. In development NOODARA_PUBLIC_URL above must be the WEB origin (http://localhost:3000),
# not this one -- the control plane's own dev PORT is 3100. The Origin guard
# (apps/control-plane/src/auth/origin-guard.ts) compares a browser mutating request's Origin header
# against NOODARA_PUBLIC_URL with strict equality, so mixing these two up fails every mutation with
# 403 FORBIDDEN_ORIGIN.
NOODARA_API_ORIGIN=

# docker-compose.dev.yml credentials (local development only — never used by the app process
# itself, which only reads DATABASE_URL/REDIS_URL above).
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=
REDIS_PASSWORD=
REDIS_PORT=

# Optional: pre-seed the single admin at first boot (D-04). Both or neither.
NOODARA_ADMIN_EMAIL=
NOODARA_ADMIN_PASSWORD=

# Optional (default false, D-07/T-1-40): set to "true" only when a trusted reverse proxy sits in
# front of the control plane. When true, the per-IP login-lockout counter uses the leftmost
# X-Forwarded-For address; when false/unset, that header is ignored entirely.
NOODARA_TRUST_PROXY=

# Optional (default 10000, D-08/D-09): SSH connect timeout in milliseconds, range 1000-120000.
NOODARA_SSH_CONNECT_TIMEOUT_MS=

# Optional (default 30000, D-08/D-09): SSH per-command timeout in milliseconds, range
# 1000-300000. Must not exceed the discovery timeout below.
NOODARA_SSH_COMMAND_TIMEOUT_MS=

# Optional (default 60000, D-08/D-09): SSH discovery run timeout in milliseconds, range
# 5000-600000. Must be greater than or equal to the command timeout above.
NOODARA_SSH_DISCOVERY_TIMEOUT_MS=

# Optional (default 5, D-24): global BullMQ worker concurrency, range 1-20.
NOODARA_WORKER_CONCURRENCY=

# Optional (default 32, D-07): max simultaneous SSE connections per API process, range 1-1000.
NOODARA_SSE_MAX_CONNECTIONS=
