# Copy to .env and fill in every value before running `docker compose -f docker-compose.dev.yml
# up` or `pnpm db:migrate`. No variable here has a default anywhere in the codebase (INST-06) —
# the process refuses to start without a real value.

# 32 raw bytes, base64-encoded. Generate with: openssl rand -base64 32
# Back this value up. Credentials encrypted with it are unrecoverable without it (D-09, D-12).
NOODARA_MASTER_KEY=

# At least 32 characters, not a known placeholder. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# postgresql://<user>:<password>@<host>:<port>/<database> — password must not be a placeholder.
DATABASE_URL=

REDIS_URL=

# Public origin the control plane is served from, e.g. https://noodara.example.com
NOODARA_PUBLIC_URL=

# The origin apps/web's next.config.ts proxies /api/* to (docs/adr/0006), e.g. http://localhost:3100
# in dev. In development NOODARA_PUBLIC_URL above must be the WEB origin (http://localhost:3000),
# not this one -- the control plane's own dev PORT is 3100. The Origin guard
# (apps/control-plane/src/auth/origin-guard.ts) compares a browser mutating request's Origin header
# against NOODARA_PUBLIC_URL with strict equality, so mixing these two up fails every mutation with
# 403 FORBIDDEN_ORIGIN.
NOODARA_API_ORIGIN=

# docker-compose.dev.yml credentials (local development only — never used by the app process
# itself, which only reads DATABASE_URL/REDIS_URL above).
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=
REDIS_PASSWORD=
REDIS_PORT=

# Optional: pre-seed the single admin at first boot (D-04). Both or neither.
NOODARA_ADMIN_EMAIL=
NOODARA_ADMIN_PASSWORD=

# Optional (default false, D-05). Set to "true" only when the panel is served over plain HTTP --
# it disables the Secure cookie attribute, so cookies survive an unencrypted connection. Written
# automatically by install.sh when the resolved NOODARA_PUBLIC_URL starts with http://; never set
# it by any other path. Must be removed once a TLS proxy sits in front of the control plane.
NOODARA_COOKIE_INSECURE=

# Optional (default false, D-07/T-1-40): set to "true" only when a trusted reverse proxy sits in
# front of the control plane. When true, the per-IP login-lockout counter uses the leftmost
# X-Forwarded-For address; when false/unset, that header is ignored entirely.
NOODARA_TRUST_PROXY=

# Optional (default 10000, D-08/D-09): SSH connect timeout in milliseconds, range 1000-120000.
NOODARA_SSH_CONNECT_TIMEOUT_MS=

# Optional (default 30000, D-08/D-09): SSH per-command timeout in milliseconds, range
# 1000-300000. Must not exceed the discovery timeout below.
NOODARA_SSH_COMMAND_TIMEOUT_MS=

# Optional (default 60000, D-08/D-09): SSH discovery run timeout in milliseconds, range
# 5000-600000. Must be greater than or equal to the command timeout above.
NOODARA_SSH_DISCOVERY_TIMEOUT_MS=

# Optional (default 5, D-24): global BullMQ worker concurrency, range 1-20.
NOODARA_WORKER_CONCURRENCY=

# Optional (default 32, D-07): max simultaneous SSE connections per API process, range 1-1000.
NOODARA_SSE_MAX_CONNECTIONS=

# --- Deploy engine (Phase 12). All optional; defaults are research values (D15/D16/D8). ---

# Optional (default 3600000 = 60 min, D15): hard max for one deploy job in milliseconds, range
# 300000-14400000. Exceeding it fails the deploy with BUILD_TIMEOUT. The BullMQ lock duration and
# the Redis cancel-key TTL are derived from it.
NOODARA_DEPLOY_MAX_MS=

# Optional (default 300000 = 5 min, D15): max time without build output in milliseconds, range
# 10000-3600000. Exceeding it fails the deploy with BUILD_STALLED. Must not exceed
# NOODARA_DEPLOY_MAX_MS.
NOODARA_DEPLOY_IDLE_MS=

# Optional (default 1, D16): deploy jobs run at once per worker, range 1-10. Separate from
# NOODARA_WORKER_CONCURRENCY because builds are heavy.
NOODARA_DEPLOY_CONCURRENCY=

# Optional (default 10485760 = 10 MiB): build-log bytes kept per deploy phase, range
# 16384-104857600. Must be at least the 16 KiB per-line cap; beyond it one truncation notice is kept.
NOODARA_DEPLOY_LOG_MAX_BYTES=

# Optional (default 250): build-log flush cadence in milliseconds, range 50-5000.
NOODARA_DEPLOY_LOG_FLUSH_MS=

# Optional (default 16384): flush early once this many build-log bytes are buffered, range
# 1024-16384. Must not exceed the 16 KiB per-line cap.
NOODARA_DEPLOY_LOG_FLUSH_BYTES=

# Optional (default 30): days build-log chunks are kept, range 1-365. Deployment rows are kept.
NOODARA_DEPLOY_LOG_RETENTION_DAYS=

# Optional (default 30000): container-state reconcile interval in milliseconds, range 5000-600000.
# One SSH connection and one docker ps per connected server per tick.
NOODARA_RECONCILE_INTERVAL_MS=

# Optional (default 1000): runtime-log lines returned by a tail request, range 1-10000.
NOODARA_RUNTIME_LOG_TAIL=

# Optional (default 600000 = 10 min, D8): max duration of one runtime-log follow stream in
# milliseconds, range 10000-3600000. The client resubscribes after it ends.
NOODARA_RUNTIME_LOG_FOLLOW_MAX_MS=
